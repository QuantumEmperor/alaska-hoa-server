# Copy this file to ".env" and fill in your real values.
# NEVER commit or share the real ".env" file - it holds secrets.

# From MongoDB Atlas: Connect > Drivers > copy the connection string,
# then put your real password in place of <db_password>.
MONGODB_URI=mongodb+srv://quantumactivist88_db_user:<db_password>@cluster0.vgzd7k2.mongodb.net/hoa_next_door?appName=Cluster0

# A long random secret used to sign login sessions.
# Generate one yourself, for example by running:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# Your own email, so only you can sign in as the administrator.
ADMIN_EMAIL=surrealblues@gmail.com

# Which web address is allowed to call this server (your published app's URL).
# Use * while testing locally, then lock it down once the app has a real address.
ALLOWED_ORIGIN=*

PORT=3000
